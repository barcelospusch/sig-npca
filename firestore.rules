rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function orientationMember(memberId) {
      let member = get(/databases/$(database)/documents/members/$(memberId)).data;
      return member.status == 'ativo'
        && member.email.lower() == request.auth.token.email.lower()
        && (member.get('positions', []).hasAny([
          {'unit': 'diretoria-orientacao', 'role': 'Assessor'},
          {'unit': 'diretoria-orientacao', 'role': 'Orientador'},
          {'unit': 'diretoria-orientacao', 'role': 'Diretor de Orientação'}
        ]) || (member.get('unit', '') == 'diretoria-orientacao'
          && member.get('role', '') in ['Assessor', 'Orientador', 'Diretor de Orientação']));
    }
    function validReport(data) {
      return data.content is string && data.content.size() <= 2000
        && data.activities is string && data.activities.size() <= 4000
        && data.notes is string && data.notes.size() <= 2000;
    }
    // Preserves the existing authenticated management access to members.
    match /members/{memberId} {
      allow read, write: if signedIn();
    }
    match /orientationAttendance/{recordId} {
      allow read: if owner(resource.data.uid);
      allow create: if owner(request.resource.data.uid)
        && orientationMember(request.resource.data.memberId)
        && request.resource.data.keys().hasOnly(['uid', 'memberId', 'memberName', 'role', 'date', 'startedAt', 'endedAt', 'content', 'activities', 'notes'])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.memberName is string
        && request.resource.data.role in ['Assessor', 'Orientador', 'Diretor de Orientação']
        && request.resource.data.startedAt == request.time
        && request.resource.data.endedAt == null
        && validReport(request.resource.data)
        && !exists(/databases/$(database)/documents/orientationAttendanceActive/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/orientationAttendanceActive/$(request.auth.uid)).data.recordId == recordId;
      allow update: if owner(resource.data.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'activities', 'notes', 'endedAt', 'updatedAt'])
        && validReport(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.endedAt == resource.data.endedAt
          || (resource.data.endedAt == null
            && request.resource.data.endedAt == request.time
            && request.resource.data.activities.size() > 0
            && get(/databases/$(database)/documents/orientationAttendanceActive/$(request.auth.uid)).data.recordId == recordId
            && !existsAfter(/databases/$(database)/documents/orientationAttendanceActive/$(request.auth.uid))));
    }
    match /orientationAttendanceActive/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['recordId'])
        && request.resource.data.recordId is string
        && getAfter(/databases/$(database)/documents/orientationAttendance/$(request.resource.data.recordId)).data.uid == uid
        && getAfter(/databases/$(database)/documents/orientationAttendance/$(request.resource.data.recordId)).data.startedAt == request.time;
      allow delete: if owner(uid)
        && getAfter(/databases/$(database)/documents/orientationAttendance/$(resource.data.recordId)).data.endedAt == request.time;
    }
  }
}
